# Single source of truth for image metadata, shared by the Justfile and by
# .github/workflows/build_reusable.yml (which drives the build through just).

# Output image name. Must be lowercase: ghcr.io rejects uppercase paths.
IMAGE_NAME=kouros

# GitHub username/organisation that owns the repo.
REPO_ORGANIZATION=mkoura

IMAGE_DESC="kourOS Customized Universal Blue Image"
IMAGE_KEYWORDS="bootc,ublue,universal-blue,bluefin"
# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"

# Variant built when none is given. CI passes the flavor explicitly.
DEFAULT_TAG=laptop

BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Root filesystem for disk images and for systems installed from the ISO.
# Required: the bluefin base declares no default, so bootc-image-builder
# refuses to generate a manifest without it.
BIB_ROOTFS=btrfs
